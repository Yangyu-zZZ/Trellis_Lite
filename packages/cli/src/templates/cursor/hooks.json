{
  "version": 1,
  "hooks": {
    "preToolUse": [],
    "sessionStart": [
      {
        "command": "{{PYTHON_CMD}} .cursor/hooks/session-start.py",
        "timeout": 30
      }
    ],
    "beforeShellExecution": [
      {
        "command": "{{PYTHON_CMD}} .cursor/hooks/inject-shell-session-context.py",
        "timeout": 5
      }
    ]
  }
}
